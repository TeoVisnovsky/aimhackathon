# Copy to backend/.env and use the key supplied in the submission form.
# Keep this file's values empty in Git. Never expose the key in frontend code.
GEMINI_API_KEY=
# Optional secondary key for ranking/summary requests:
# GEMINI_API_KEY_2=
LLM_PROVIDER=gemini

# Optional model overrides (otherwise the backend defaults apply):
# EMBED_MODEL=gemini-embedding-001
# SUMMARY_MODEL=gemini-flash-lite-latest
# SUMMARY_CHECK_MODEL=gemini-flash-lite-latest

# Role/task planning uses the decision graph; Gemini handles retrieval and finalization.
PROMPT_LLM=off
PROMPT_EMBEDDINGS=off
ENCRYPT_AT_REST=1
